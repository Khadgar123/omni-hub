<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.omni-hub.monthly</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON}}</string>
        <string>-m</string>
        <string>omni_hub.cli</string>
        <string>schedule-tick</string>
        <string>--period</string>
        <string>monthly</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>{{WORKSPACE}}/src</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>{{WORKSPACE}}</string>

    <!-- 1st of the month, 8 AM. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key><integer>1</integer>
        <key>Hour</key><integer>8</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>WakeSystem</key>
    <true/>
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>{{WORKSPACE}}/.omni/launchd/monthly.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{WORKSPACE}}/.omni/launchd/monthly.err.log</string>
</dict>
</plist>
