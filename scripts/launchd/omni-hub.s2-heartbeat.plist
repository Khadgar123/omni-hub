<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.omni-hub.s2-heartbeat</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON}}</string>
        <string>{{WORKSPACE}}/scripts/s2_heartbeat.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{WORKSPACE}}</string>

    <!-- Wednesday 9 AM. Offset from weekly schedule-tick (Monday 8 AM) so
         the two never contend for the same network burst. 8-9 fires per
         60-day S2 recycle window — ample buffer. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>3</integer>
        <key>Hour</key><integer>9</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>WakeSystem</key>
    <true/>
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>{{WORKSPACE}}/.omni/launchd/s2-heartbeat.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{WORKSPACE}}/.omni/launchd/s2-heartbeat.err.log</string>
</dict>
</plist>
